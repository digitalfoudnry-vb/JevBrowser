{
  "mcp": {
    "servers": {
      "jev-browser": {
        "command": "node",
        "args": ["--env-file=/absolute/path/to/jev-browser.env", "/absolute/path/to/JevBrowser/dist/index.js"],
        "requestTimeoutMs": 210000,
        "toolFilter": { "include": ["jev_navigate"] }
      }
    }
  }
}
