{
  "name": "@digitalfoudnry-vb/jev-browser",
  "version": "0.1.0",
  "description": "Autonomous browser environment powered by Jev intelligence",
  "type": "module",
  "license": "MIT",
  "author": "digitalfoundry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalfoudnry-vb/JevBrowser.git"
  },
  "bin": {
    "jev-browser": "./dist/index.js",
    "jev": "./dist/index.js"
  },
  "main": "./dist/library.js",
  "types": "./dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./navigator": {
      "types": "./dist/jev/navigator.d.ts",
      "default": "./dist/jev/navigator.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "integrations",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit.test.mjs test/compiler.test.mjs test/install.test.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run validate:skill",
    "validate:skill": "node scripts/validate-skill.mjs",
    "browser:install": "playwright install chromium",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "keywords": [
    "jev-browser",
    "jev",
    "mcp",
    "browser",
    "automation",
    "agent",
    "playwright"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/openai": "4.0.71",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.105",
    "ipaddr.js": "2.5.0",
    "playwright": "^1.55.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.0"
  },
  "private": true
}
